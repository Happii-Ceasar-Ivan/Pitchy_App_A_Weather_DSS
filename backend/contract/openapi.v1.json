    "/api/v1/match-contexts/{match_context_id}/conversation": {
      "post": {
        "tags": [
          "match contexts"
        ],
        "summary": "Ask Question",
        "description": "Role-adapted explanation of the active assessment and approved guidance.\n\nLimited per session with a sliding window; the first prompt over the limit starts a cooldown\nand returns 429 with ``retry_at``. Only prompts sent to an AI provider count.",
        "operationId": "ask_question_api_v1_match_contexts__match_context_id__conversation_post",
        "parameters": [
          {
            "name": "match_context_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Match Context Id"
            }
          },
          {
            "name": "X-Session-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Anonymous session token from POST /sessions.",
              "title": "X-Session-Token"
            },
            "description": "Anonymous session token from POST /sessions."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED. Body has retry_at; Retry-After header gives seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
