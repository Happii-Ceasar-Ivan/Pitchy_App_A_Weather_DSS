  "components": {
    "schemas": {
      "ConversationRequest": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ConversationRole"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "question"
        ],
        "title": "ConversationRequest"
      },
      "ConversationResponse": {
        "properties": {
          "match_context_id": {
            "type": "string",
            "format": "uuid",
            "title": "Match Context Id"
          },
          "assessment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assessment Id",
            "description": "Assessment the answer explains, if any."
          },
          "role": {
            "$ref": "#/components/schemas/ConversationRole"
          },
          "generation": {
            "type": "string",
            "enum": [
              "generated",
              "unavailable"
            ],
            "title": "Generation",
            "description": "'unavailable' when no AI provider answered (FR-AGT-006)."
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer",
            "description": "AI-generated explanation. Not an official decision."
          },
          "references": {
            "items": {
              "$ref": "#/components/schemas/GuidanceReference"
            },
            "type": "array",
            "title": "References"
          },
          "limitations": {
            "items": {
              "$ref": "#/components/schemas/Limitation"
            },
            "type": "array",
            "title": "Limitations"
          },
          "responded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Responded At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match_context_id",
          "assessment_id",
          "role",
          "generation",
          "answer",
          "responded_at"
        ],
        "title": "ConversationResponse"
      },
      "ConversationRole": {
        "type": "string",
        "enum": [
          "coach",
          "match_official",
          "referee",
          "medical_staff",
          "spectator"
        ],
        "title": "ConversationRole",
        "description": "Conversational context only, not an authenticated account role (P-03)."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable summary. Never contains internal details."
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Matches the X-Request-ID response header."
          },
          "retry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At",
            "description": "When a RATE_LIMITED request may be retried (UTC). Also sent as Retry-After."
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "INVALID_SESSION",
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "INGESTION_NOT_NEEDED",
          "PAYLOAD_TOO_LARGE",
          "RATE_LIMITED",
          "NOT_IMPLEMENTED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Dotted location of the invalid input."
          },
          "issue": {
            "type": "string",
            "title": "Issue"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "issue"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "GuidanceReference": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "authority": {
            "type": "string",
            "title": "Authority",
            "description": "Issuing body, e.g. the football authority."
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Version or date of the approved document."
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          }
        },
        "additionalProperties": false,
