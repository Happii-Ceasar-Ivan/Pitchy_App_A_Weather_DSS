tmp/
temp/
dist/
out/

# Local IDE and operating system files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local-only project documents (kept out of the public repository)
/references/
/Instructions/
/docs/
/AGENTS.md
/PROJECT_STRUCTURE.md
/config/environments/

# Flutter app: files that could hold secrets or local config by accident
/apps/flutter_app/**/secrets.dart
/apps/flutter_app/**/*.secret.dart
/apps/flutter_app/**/env.g.dart
/apps/flutter_app/**/dart_defines*.json
# Windows code-signing certificates
*.pfx
*.p12

# Local AI-assistant tooling (includes the Supabase project ref in .mcp.json)
/.claude/
/.mcp.json
/skills-lock.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv-cache/
backend/.tmp/

# RAG source text (copyrighted manuals; loaded from the PC, never pushed)
